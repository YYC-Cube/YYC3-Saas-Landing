# YYC³ SaaS Landing — 环境变量模板
# 规则：仅声明变量名，禁止写入任何真实值（密钥/凭证/内网地址/IP）。
# 使用：cp .env.example .env.local，并在本地或 CI Secrets 中注入实际值。
# 所有连接信息（含 NAS 主库端口 5433）必须由部署环境注入，不得写入仓库。

# ---- 独立服务（server/）----
# 服务监听端口与地址（可选，端口合法性由 server/config.ts 校验）
PORT=
HOST=

# PG17 主库（NAS 主库）—— 必填，连接串由环境注入
DATABASE_URL=
# PG17 备库（本机）—— 可选，配置后只读请求与故障降级可用
DATABASE_STANDBY_URL=

# Redis 缓存（兼容 Upstash REST 语义）
KV_REST_API_URL=
KV_REST_API_TOKEN=
# 或使用标准 Redis 连接串（与上述二选一）
REDIS_URL=
REDIS_TOKEN=

# 模型调用（OpenAI 兼容 Chat Completions 端点）
MODEL_API_BASE_URL=
MODEL_API_KEY=
MODEL_NAME=

# 独立服务鉴权令牌（必填，缺失时服务拒绝启动所有受保护端点）
SERVICE_API_TOKEN=

# ---- 前端（静态导出）----
NEXT_PUBLIC_SITE_URL=
